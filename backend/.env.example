# 🔌 Server & Node Configuration
PORT=5000
NODE_ENV=development

# 💾 Database Connection
MONGO_URI=mongodb://localhost:27017/skillbridge

# 🛡️ Session Security (Minimum 32-character random string)
SESSION_SECRET=your_32_char_random_security_secret_key

# 🌐 Client URL (Frontend CORS Configuration)
CLIENT_URL=http://localhost:5173

# 🔑 OAuth Credentials (Google and GitHub Logins)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ☁️ Cloudinary Configurations (Asset Storage & Marksheet Parsing)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 🧠 AI Service Providers (Gemini: Main Features | Mistral / OpenAI: Chatbots)
GEMINI_API_KEY=your_google_gemini_api_key
MISTRAL_API_KEY=your_mistral_ai_api_key
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=your_openai_api_key

# 🍿 YouTube API Integration (Learning Hub Course Stream)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# 📧 Email Server Settings (SMTP / Nodemailer Transactions)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address@gmail.com
SMTP_PASS=your_gmail_app_specific_password
EMAIL_FROM="SkillBridge <noreply@skillbridge.app>"

# 🌐 Alternative Chromium/Puppeteer Paths (Optional, uncomment if needed)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
